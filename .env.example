# ==============================================================================
# QuantumHost Environment Configuration
# ==============================================================================

# Public App URL (used for OAuth callbacks, webhook URLs, and preview links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Database & Auth)
# Never expose SUPABASE_SERVICE_ROLE_KEY with NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# AES-256-GCM Master Encryption Key (64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=

# Redis & BullMQ (Required for deployment job queue & build workers)
REDIS_URL=redis://127.0.0.1:6379

# GitHub Integration (GitHub App + OAuth)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Artifact Object Storage ("local" | "s3" | "supabase")
# Use "s3" for Cloudflare R2 or AWS S3
ARTIFACT_STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.quantumhost-storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=quantumhost-deployments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Hosting Provider & Multi-Tenant Domains (Cloudflare for SaaS / QuantumHost Edge)
# Supported: "quantumhost-edge" (auto-upgrades to "cloudflare" when credentials are present)
HOSTING_PROVIDER=quantumhost-edge
NEXT_PUBLIC_PLATFORM_DOMAIN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_CUSTOM_ORIGIN_DOMAIN=

# Build Worker Limits
BUILD_TIMEOUT_MS=180000
BUILD_MAX_OUTPUT_BYTES=52428800
DOCKER_ISOLATION=false

# Provider-Independent AI Integration Layer
# Providers: "gemini" | "openai" | "anthropic" | "openai_compatible"
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=
AI_BASE_URL=
